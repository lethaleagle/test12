<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keypad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/keypad_padding"
    android:columnCount="4"
    android:rowCount="5">

    <!-- row 1 -->
    <Button
        style="@style/Key.Clear"
        android:id="@+id/key_clear"
        android:text="@string/key_clear"
        android:tag="clear"
        android:contentDescription="@string/desc_clear" />
    <Button
        style="@style/Key.Function"
        android:id="@+id/key_delete"
        android:text="@string/key_delete"
        android:tag="delete"
        android:contentDescription="@string/desc_delete" />
    <Button
        style="@style/Key.Function"
        android:id="@+id/key_percent"
        android:text="@string/key_percent"
        android:tag="percent"
        android:contentDescription="@string/desc_percent" />
    <Button
        style="@style/Key.Operator"
        android:id="@+id/key_divide"
        android:text="@string/key_divide"
        android:tag="÷"
        android:contentDescription="@string/desc_divide" />

    <!-- row 2 -->
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_7"
        android:text="7"
        android:tag="7" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_8"
        android:text="8"
        android:tag="8" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_9"
        android:text="9"
        android:tag="9" />
    <Button
        style="@style/Key.Operator"
        android:id="@+id/key_multiply"
        android:text="@string/key_multiply"
        android:tag="×"
        android:contentDescription="@string/desc_multiply" />

    <!-- row 3 -->
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_4"
        android:text="4"
        android:tag="4" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_5"
        android:text="5"
        android:tag="5" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_6"
        android:text="6"
        android:tag="6" />
    <Button
        style="@style/Key.Operator"
        android:id="@+id/key_subtract"
        android:text="@string/key_subtract"
        android:tag="−"
        android:contentDescription="@string/desc_subtract" />

    <!-- row 4 -->
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_1"
        android:text="1"
        android:tag="1" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_2"
        android:text="2"
        android:tag="2" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_3"
        android:text="3"
        android:tag="3" />
    <Button
        style="@style/Key.Operator"
        android:id="@+id/key_add"
        android:text="@string/key_add"
        android:tag="+"
        android:contentDescription="@string/desc_add" />

    <!-- row 5 -->
    <Button
        style="@style/Key.Function"
        android:id="@+id/key_sign"
        android:text="@string/key_sign"
        android:tag="sign"
        android:contentDescription="@string/desc_sign" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_0"
        android:text="0"
        android:tag="0" />
    <Button
        style="@style/Key.Number"
        android:id="@+id/key_decimal"
        android:text="@string/key_decimal"
        android:tag="."
        android:contentDescription="@string/desc_decimal" />
    <Button
        style="@style/Key.Equals"
        android:id="@+id/key_equals"
        android:text="@string/key_equals"
        android:tag="equals"
        android:contentDescription="@string/desc_equals" />

</GridLayout>
