<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingStart="@dimen/display_padding"
        android:paddingEnd="@dimen/display_padding"
        android:paddingBottom="@dimen/display_padding"
        android:paddingTop="@dimen/display_padding">

        <HorizontalScrollView
            android:id="@+id/expression_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:contentDescription="@string/desc_expression"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/expression_text" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/desc_result"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/result_text" />
    </LinearLayout>

    <include
        layout="@layout/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2" />

</LinearLayout>
