<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Keys are laid out by GridLayout weights, so every one of them is
         "fill the cell I was given" plus a margin. -->
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">@dimen/key_margin</item>
        <item name="android:textSize">@dimen/key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Key.Number">
        <item name="android:background">@drawable/key_number</item>
        <item name="android:textColor">@color/key_number_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Key.Function">
        <item name="android:background">@drawable/key_function</item>
        <item name="android:textColor">@color/key_function_text</item>
    </style>

    <style name="Key.Clear">
        <item name="android:background">@drawable/key_function</item>
        <item name="android:textColor">@color/key_clear_text</item>
    </style>

    <style name="Key.Operator">
        <item name="android:background">@drawable/key_operator</item>
        <item name="android:textColor">@color/key_operator_text</item>
        <item name="android:textSize">@dimen/key_text</item>
    </style>

    <style name="Key.Equals">
        <item name="android:background">@drawable/key_equals</item>
        <item name="android:textColor">@color/key_equals_text</item>
    </style>
</resources>
